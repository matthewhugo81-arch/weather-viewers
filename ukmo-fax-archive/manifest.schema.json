{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UKMO FAX archive manifest v1",
  "type": "object",
  "required": ["schema_version", "updated_at", "charts", "pending"],
  "properties": {
    "schema_version": {"const": 1},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "charts": {"type": "array", "items": {"$ref": "#/$defs/chart"}},
    "pending": {"type": "array", "items": {"$ref": "#/$defs/pending"}}
  },
  "$defs": {
    "common": {
      "type": "object",
      "required": ["id", "issue_time", "valid_time", "lead_hours", "source", "filename", "download_time", "sha256", "product", "source_url", "metadata_method", "issue_time_basis"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "lead_hours": {"enum": [0, 24, 36, 48, 60, 72, 84, 96, 120]},
        "source": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
        "filename": {"type": "string", "pattern": "^archive/objects/[a-z0-9_-]+/[a-f0-9]{64}\\.png$"},
        "download_time": {"type": "string", "format": "date-time"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "product": {"type": "string"},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "metadata_method": {"enum": ["printed-header-ocr", "manual", "needs-review"]},
        "issue_time_basis": {"type": "string"}
      }
    },
    "chart": {
      "allOf": [{"$ref": "#/$defs/common"}, {"properties": {
        "issue_time": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"},
        "valid_time": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"},
        "metadata_method": {"enum": ["printed-header-ocr", "manual"]}
      }}]
    },
    "pending": {
      "allOf": [{"$ref": "#/$defs/common"}, {"required": ["review_reason"], "properties": {
        "issue_time": {"type": "null"}, "valid_time": {"type": "null"},
        "metadata_method": {"const": "needs-review"}, "review_reason": {"type": "string"}
      }}]
    }
  }
}
